<Window x:Class="TubePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TubePlayer"
        mc:Ignorable="d"
        Title="MainWindow" Height="774" Width="1356"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Border CornerRadius="10" BorderThickness="2">
        <Border.BorderBrush>
            <SolidColorBrush Color="{StaticResource WinColor1}"></SolidColorBrush>
        </Border.BorderBrush>

        <Border.Background>
            <SolidColorBrush Color="{StaticResource WinColor2}"></SolidColorBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="Window_MouseDown" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Text="TubePlayer - Youtube Player"
                    Foreground="{StaticResource NavMainColor1}"
                    FontSize="14"
                    FontFamily="Segoe UI"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Grid.Column="0" FontWeight="DemiBold"/>

                <Button x:Name="frmCtrl_min"
                    BorderThickness="0"
                    Content="-"
                    FontSize="14"
                    Foreground="White"
                    FontFamily="Segoe UI"
                    Grid.Column="1"
                    Click="frmCtrl_winState">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF8C8C8C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="frmCtrl_max"
                    BorderThickness="0"
                    Content="o"
                    FontSize="14"
                    Foreground="White"
                    FontFamily="Segoe UI"
                    Grid.Column="2"
                    Click="frmCtrl_winState">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF8C8C8C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="frmCtrl_exit"
                    BorderThickness="0"
                    Content="x"
                    FontSize="14"
                    Foreground="White"
                    FontFamily="Segoe UI"
                    Grid.Column="3"
                    Click="frmCtrl_winState">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Black"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFFF3737"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Top" Grid.Column="0" Margin="0,20,0,0">

                    <RadioButton>
                        <StackPanel Orientation="Horizontal">
                            <Image></Image>
                            <TextBlock Text="Dashboard" Foreground="white"></TextBlock>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton>
                        <StackPanel Orientation="Horizontal">
                            <Image></Image>
                            <TextBlock Text="Manage Playlist" Foreground="white"></TextBlock>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton>
                        <StackPanel Orientation="Horizontal">
                            <Image></Image>
                            <TextBlock Text="Settings" Foreground="white"></TextBlock>
                        </StackPanel>
                    </RadioButton>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="P L A Y L I S T" Foreground="{StaticResource NavMainColor1}" FontSize="12" Padding="20,0,0,0" FontWeight="Bold" Grid.Column="0"/>

                        <TextBlock Text="+" Foreground="{StaticResource NavMainColor1}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
                    </Grid>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Border CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF232323" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.75"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>

</Window>
